{
  "name": "bible-pro",
  "version": "0.2.0",
  "private": true,
  "description": "The world's most advanced Bible study platform - combining cutting-edge technology with deep biblical scholarship",
  "repository": {
    "type": "git",
    "url": "https://github.com/xebotic/test3.git"
  },
  "keywords": [
    "bible",
    "bible-study",
    "scripture",
    "theology",
    "biblical-analysis",
    "hebrew",
    "greek",
    "original-languages",
    "linguistics",
    "ai",
    "machine-learning",
    "nlp"
  ],
  "author": "Bible Pro Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xebotic/test3/issues"
  },
  "homepage": "https://github.com/xebotic/test3#readme",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "node data/scripts/migrate.js",
    "db:seed": "node data/scripts/seed.js",
    "db:import": "tsx data/scripts/importBibleText.ts"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/pg": "^8.10.9",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
