# Database Configuration
DATABASE_URL=postgresql://bibleuser:biblepass@localhost:5432/bible_study
POSTGRES_DB=bible_study
POSTGRES_USER=bibleuser
POSTGRES_PASSWORD=biblepass

# Redis Configuration
REDIS_URL=redis://localhost:6379

# API Configuration
CONTENT_SERVICE_URL=http://localhost:3001
NLP_SERVICE_URL=http://localhost:8000
API_GATEWAY_URL=http://localhost:4000

# Authentication (Auth0 or Supabase)
AUTH_PROVIDER=auth0
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_AUDIENCE=your-api-audience

# OpenAI Configuration (for AI features)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Vector Database (Pinecone)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-environment
PINECONE_INDEX_NAME=bible-verses

# Application Settings
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
